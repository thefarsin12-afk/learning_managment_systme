# ===== COURSE APPLICATION API =====

#api for list all courses
###
GET http://127.0.0.1:8000/course/courses/
Accept: application/json
Authorization: Token aee60a8fd36e49277dad070f598daaa27823e1c7

#api for add to course
###
POST http://127.0.0.1:8000/course/courses/
Content-Type:  application/json
Authorization: Token f3b9013d86f89ad4b08d0a5c10710f1247e0d821

{
    "title": "Audio Production & Scriptwriting",
    "language": "Malayalam, English",
    "description": "Learn professional audio recording, voice-over techniques, sound editing, podcast production, storytelling and creative scriptwriting for films, documentaries and digital media.",
    "duration": "3 Months",
    "price": "18000"
}

#api for retrieve course
###
GET http://127.0.0.1:8000/course/courses/2/
Accept: application/json
Authorization: Token aee60a8fd36e49277dad070f598daaa27823e1c7

#api for update course
###
