# ===== COURSE APPLICATION API =====

#api for list all courses
###
GET http://127.0.0.1:8000/course/courses/
Accept: application/json
Authorization: Token aee60a8fd36e49277dad070f598daaa27823e1c7

#api for add to course
###
POST http://127.0.0.1:8000/course/courses/
Content-Type:  application/json
Authorization: Token 6f524db031bf6997504821be00dec89540e13b07

{
    "title": "Python Django Full Stack Development",
    "language": "Python",
    "description": "Learn Python, Django, Django REST Framework, MySQL and API development.",
    "trainer": 1,
    "duration": "6 Months",
    "price": "25000"
}

#api for retrieve course
###
GET http://127.0.0.1:8000/course/courses/2/
Accept: application/json
Authorization: Token aee60a8fd36e49277dad070f598daaa27823e1c7

#api for update course
###
PUT http://127.0.0.1:8000/course/courses/2/
Content-Type:application/json
Authorization: Token aee60a8fd36e49277dad070f598daaa27823e1c7

{
  "id": 1,
  "title": "Full Stack Development",
  "language": "Python, Django,Mysql,React.js",
  "description": "Complete Full Stack Development course covering frontend, backend, database management and REST API development.",
  "duration": "6 Months",
  "price": "32000",
  "created_at": "2026-11-20T11:21:30.847845Z",
  "updated_at": "2026-11-20T11:21:30.847895Z",
  "trainer": 3
}

#api for delete course
###
DELETE http://127.0.0.1:8000/course/courses/2/
Accept: application/json
Authorization: Token aee60a8fd36e49277dad070f598daaa27823e1c7
